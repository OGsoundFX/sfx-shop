<% payment_item_count = @order.packs.size + @order.tracks.size + (@collection ? 1 : 0) + (@order.multiple == false ? 1 : 0) %>

<div class="content payment-checkout-page">
  <main class="payment-checkout-shell">
    <header class="payment-checkout-header">
      <div>
        <p class="payment-checkout-eyebrow">SECURE CHECKOUT</p>
        <h1>Review your order</h1>
        <p class="payment-checkout-description">Check your items and total before completing your purchase.</p>
      </div>
      <div class="payment-checkout-secure-badge">
        <i class="fas fa-lock" aria-hidden="true"></i>
        Secure payment
      </div>
    </header>

    <div class="payment-checkout-layout">
      <section class="payment-order-column" aria-labelledby="payment-order-title">
        <div class="payment-checkout-card payment-order-card">
          <div class="payment-checkout-card-heading">
            <div class="payment-checkout-card-title">
              <span class="payment-checkout-heading-icon"><i class="fas fa-receipt" aria-hidden="true"></i></span>
              <div>
                <h2 id="payment-order-title">Order details</h2>
                <p>Your selected sounds and packs</p>
              </div>
            </div>
            <span class="payment-checkout-item-count">
              <%= pluralize(payment_item_count, "item") %>
            </span>
          </div>

          <div class="payment-order-items">
            <% if @order.packs == [] && @order.collections == [] && @order.tracks == [] %>
              <div class="pack-payment-checkout">
                <%= render "shared/payment_single_pack" %>
              </div>
            <% end %>

            <% if @order.packs != [] %>
              <div class="pack-payment-checkout">
                <%= render "shared/payment_packs" %>
              </div>
            <% end %>

            <% if !@collection.nil? %>
              <div class="collection-payment-checkout">
                <div class="payment_collection_tracks_desktop_view">
                  <%= render "shared/payment_collection_tracks" %>
                </div>
                <div class="payment_collection_tracks_mobile_view">
                  <%= render "shared/payment_collection_tracks_mobile" %>
                </div>
              </div>
            <% end %>

            <% if @order.tracks != [] %>
              <div class="tracks-payment-checkout">
                <div class="payment_collection_tracks_desktop_view">
                  <%= render "shared/payment_single_tracks" %>
                </div>
                <div class="payment_collection_tracks_mobile_view">
                  <%= render "shared/payment_single_tracks_mobile" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </section>

      <aside class="payment-summary-column" aria-labelledby="payment-summary-title">
        <div class="payment-checkout-card payment-summary-card">
          <div class="payment-checkout-card-heading">
            <div class="payment-checkout-card-title">
              <span class="payment-checkout-heading-icon"><i class="fas fa-shopping-bag" aria-hidden="true"></i></span>
              <div>
                <h2 id="payment-summary-title">Payment summary</h2>
                <p>VAT included in the total</p>
              </div>
            </div>
          </div>

          <div class="payment-summary-total">
            <span>Total amount</span>
            <strong><%= humanized_money(@order.amount, symbol: session[:currency]) %></strong>
          </div>

          <p class="payment-summary-tax-note">
            <i class="fas fa-check-circle" aria-hidden="true"></i>
            VAT included · One-time payment
          </p>

          <div class="payment-checkout-actions">
            <div id="pay" class="btn btn-primary btn-pay-checkout">
              <i class="fas fa-lock" aria-hidden="true"></i>
              Pay <%= humanized_money(@order.amount, symbol: session[:currency]) %>
            </div>
            <%= link_to "Cancel order", destroy_order_path, class: "btn btn-cancel-checkout" %>
          </div>
          <p class="payment-summary-secure-note">Payments are securely processed by Stripe.</p>
        </div>
      </aside>
    </div>

    <script src="https://js.stripe.com/v3/"></script>
    <script>
      const paymentButton = document.getElementById('pay');
      paymentButton.addEventListener('click', () => {
        const stripe = Stripe('<%= ENV['STRIPE_PUBLISHABLE_KEY'] %>');
        stripe.redirectToCheckout({
          sessionId: '<%= @order.checkout_session_id %>'
        });
      });
    </script>
  </main>
</div>
