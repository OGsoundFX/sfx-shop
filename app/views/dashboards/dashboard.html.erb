<div class="content admin-min-height bg-dark cart-builder-page dashboard-page">
  <%= render "shared/left_pannel_mobile" %>
  <div class="cart-builder-layout">
    <div class="cart-builder-sidebar">
      <%= render "shared/left_pannel_desktop_dark" %>
    </div>
    <main class="cart-builder-content dashboard-content">
      <h1 class="dashboard-title">Your dashboard</h1>

      <section id="newsletter-info-card">
        <% if @status == "subscribed" %>
          <i class="fas fa-info-circle" aria-hidden="true"></i>
          <span>You have subscribed to our <strong>newsletter</strong>. Click <%= link_to "here", unsubscribe_path %> to unsubscribe and miss all our great news and deals!</span>
        <% else %>
          <i class="fas fa-info-circle" aria-hidden="true"></i>
          <span>Subscribe to our newsletter to get cool news and discounts all year long, AND receive a free pack of sounds right away! <%= link_to "CLICK HERE", subscribe_path %></span>
        <% end %>
      </section>

      <% if @orders.count == 0 %>
        <section class="cart-empty-state dashboard-empty-state">
          <i class="fas fa-box-open" aria-hidden="true"></i>
          <h2>You haven't purchased anything yet</h2>
          <p>Explore the sound library and your purchases will appear here.</p>
          <%= link_to "Explore sounds", root_path, class: "cart-builder-button" %>
        </section>
      <% else %>
        <div id="order-card-desktop">
          <%= render 'shared/order_card_desktop' %>
        </div>

        <div id="order-card-mobile">
          <%= render 'shared/order_card_mobile' %>
        </div>
      <% end %>
    </main>
  </div>
</div>
