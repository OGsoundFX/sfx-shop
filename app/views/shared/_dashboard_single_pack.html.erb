<% total_pack_price = 0 %>
<% pack =  SfxPack.find(order.sfx_pack_id) %>

  <div class="d-flex justify-content-between dashboard-pack-item">
    <div class="d-flex">
      <div class="dashboard-pack-image"><%= image_tag pack.photos[0], alt: pack.title %></div>
      <div class="d-flex flex-column justify-content-center pack-details" style="text-align: left">
      <h5><%= pack.title %></h5>
        <% if order.sales != {} %>
          <% if order.sales[pack.to_s] %>
            <h5 id="price-pack">Price:  <strong> <%= humanized_money(pack.price * (1 - order.sales[pack.to_s][order.sales[pack.to_s].keys.first] / 100.to_f), symbol: session[:currency]) %> </strong> <span id="instead-dashboard"> <i> (instead of <%= humanized_money(pack.price, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </span> </h5>
            <h5 id="instead-under"> <i> (instead of <%= humanized_money(pack.price, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </h5>
          <% else %>
            <h5 id="price-pack">Price: <strong> <%= humanized_money(pack.price, symbol: session[:currency]) %> </strong> </h5>
          <% end %>
        <% else %>
          <h5 id="price-pack">Price: <strong> <%= humanized_money(pack.price, symbol: session[:currency]) %> </strong> </h5>
        <% end %>
      </div>
    </div>

    <div class="dashboard-pack-downloads">
      <% pack_links = pack.product_link.split(',') %>
      <% pack_links.each_with_index do |link, index| %>
        <%= link_to (pack_links.one? ? "Download Pack" : "Download Pack part #{index + 1}"), link, oncontextmenu: "return false;", class: "dashboard-download-button" %>
      <% end %>
    </div>
  </div>
