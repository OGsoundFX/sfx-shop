<% if index.positive? %>
  <div class="d-flex">
    <div><%= image_tag SfxPack.find(pack).photos[0], width: "120px", id: "image-pack" %></div>
    <div class="d-flex flex-column justify-content-center pack-details" style="text-align: left">
    <h5><%= SfxPack.find(pack).title %></h5>
      <% if order.sales != {} %>
        <% if order.sales[pack.to_s] %>
          <h5 id="price-pack">Price:  <strong> <%= humanized_money((SfxPack.find(pack).price * conversion_rate) * (1 - order.sales[pack.to_s][order.sales[pack.to_s].keys.first] / 100.to_f), symbol: session[:currency]) %> </strong> <span id="instead-dashboard"> <i> (instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </span> </h5>
          <h5 id="instead-under"> <i> (instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </h5>
        <% else %>
          <h5 id="price-pack">Price: <strong> <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %> </strong> </h5>
        <% end %>
      <% else %>
        <% if index.positive? %>
          <h5 id="price-pack">Price: <strong> <%= humanized_money((SfxPack.find(pack).price * conversion_rate) * 0.8, symbol: session[:currency]) %> </strong> <span id="instead-dashboard"> <i> (instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>) </i> </span> </h5>
          <h5 id="instead-under"> <i>(instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>)</i> </h5>
        <% else %>
          <h5 id="price-pack">Price: <strong> <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %> </strong> </h5>
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="d-flex">
    <div><%= image_tag SfxPack.find(pack).photos[0], width: "120px", id: "image-pack"  %></div>
    <div class="d-flex flex-column justify-content-center pack-details" style="text-align: left">
    <h5><%= SfxPack.find(pack).title %></h5>
      <% if order.sales != {} && order.sales[pack.to_s] %>
        <h5 id="price-pack">Price:  <strong> <%= humanized_money((SfxPack.find(pack).price * conversion_rate) * (1 - order.sales[pack.to_s][order.sales[pack.to_s].keys.first] / 100.to_f), symbol: session[:currency]) %> </strong> <span id="instead-dashboard"> <i> (instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </span> </h5>
        <h5 id="instead-under"> <i> (instead of <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %>) - <%= order.sales[pack.to_s][order.sales[pack.to_s].keys.first] %> % OFF </i> </h5>
      <% else %>
        <h5 id="price-pack">Price: <strong> <%= humanized_money(SfxPack.find(pack).price * conversion_rate, symbol: session[:currency]) %> </strong> </h5>
      <% end %>
    </div>
  </div>
<% end %>
