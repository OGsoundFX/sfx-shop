<% if "$" != session[:currency] %>
  <% conversion_rate = CurrencyRate.where("base = ? AND target = ?", "USD", "EUR").order(created_at: :desc).first.rate.to_f %>
<% else %>
  <% conversion_rate = 1 %>
<% end %>

<div class="packs-display cart-collection-panel" id="collection-display" style="visibility: hidden" data-unwrap-cart-target="collectionUnwrapped">
  <div class="cart-collection-panel-heading">
    <div class="cart-collection-panel-title">
      <i class="fas fa-layer-group" aria-hidden="true"></i>
      <div>
        <h3>COLLECTION</h3>
        <span>Collection total · <%= humanized_money(@current_collections.first.price, symbol: session[:currency]) %></span>
      </div>
    </div>
    <div class="cart-collection-panel-actions">
      <%= link_to destroy_collection_path(collection: @current_collections.first), method: :delete, class: "collection-destroy-button", aria: { label: "Remove collection" }, data: { confirm: "Are you sure?" } do %>
        <i class="fas fa-times" aria-hidden="true"></i>
      <% end %>
      <i class="fas fa-angle-up" data-action="click->unwrap-cart#wrap" id="collection-arrow" aria-label="Collapse collection"></i>
    </div>
  </div>

  <% @current_collections.each do |collection| %>
    <% collection_tracks = SingleTrack.where(id: collection.tracks) %>
    <% collection_tracks_by_id = collection_tracks.index_by(&:id) %>
    <% individual_value = collection_tracks.sum(&:price_cents) / 100.0 %>
    <% collection_savings = (individual_value * conversion_rate) - collection.price.to_f %>

    <div class="cart-collection-body">
      <%= render "shared/cart/collection_info",
          collection: collection,
          individual_value: individual_value,
          collection_savings: collection_savings,
          conversion_rate: conversion_rate %>

      <%= link_to pack_builder_path, id: "btn-cart-collection-full-width", class: "cart-collection-add-tracks" do %>
        <i class="fas fa-plus" aria-hidden="true"></i>
        Add or remove tracks from this collection
      <% end %>

      <ul class="cart-collection-tracks">
        <% collection.tracks.each do |track_id| %>
          <% track = collection_tracks_by_id[track_id] %>
          <% if track %>
            <% preview_id = "#{track.id}#{collection.id}" %>
            <li class="cart-collection-track">
              <div class="cart-collection-track-identity">
                <span class="icon-adjust-pack-builder"><%= sanitize @icons[track.category.to_sym] %></span>
                <div class="cart-collection-track-details">
                  <span class="cart-collection-track-title"><%= track.title %></span>
                  <span class="cart-collection-track-category"><%= track.category.capitalize %> · <%= track.loop? ? "Loop" : "No loop" %></span>
                </div>
                <% if track.loop? %>
                  <span class="cart-collection-track-loop" aria-label="Loop"><i class="fas fa-repeat" aria-hidden="true"></i></span>
                <% end %>
              </div>

              <div class="cart-collection-track-preview">
                <div class="wave wave-mobile collection-wave <%= controller_name == 'carts' && action_name == 'cart' ? 'wave-cart' : 'wave-index' %>"
                     id="id<%= preview_id %>"
                     data-link="<%= track.preview_link %>">
                  <div id="loading_flag<%= preview_id %>" class="loading-countdown"></div>
                </div>
                <span class="cart-collection-track-duration" id="trackDurationid<%= preview_id %>"></span>
                <i class="fas fa-play-circle play-icon-margin-pack-builder cursor cart-collection-desktop-play" id="playid<%= preview_id %>" aria-label="Play preview"></i>
                <i class="fas fa-pause-circle play-icon-margin-pack-builder cursor cart-collection-desktop-play" id="stopid<%= preview_id %>" style="display: none" aria-label="Pause preview"></i>
                <i class="fas fa-play-circle play-icon-margin-pack-builder cursor cart-collection-mobile-play" id="mobilePlayid<%= preview_id %>" aria-label="Play preview"></i>
                <i class="fas fa-pause-circle play-icon-margin-pack-builder cursor cart-collection-mobile-play" id="mobileStopid<%= preview_id %>" style="display: none" aria-label="Pause preview"></i>
              </div>

              <div class="cart-collection-track-info">
                <span class="cart-collection-track-points"><%= track.points %> <%= "point".pluralize(track.points) %></span>
                <span class="cart-collection-track-price"><%= humanized_money(track.price * conversion_rate, symbol: session[:currency]) %></span>
                <button type="button" class="cart-collection-track-info-button" id="trackInfoBtn" data-trackId="<%= preview_id %>" aria-label="Details for <%= track.title %>">
                  <i class="fas fa-info-circle" aria-hidden="true"></i>
                </button>
              </div>

              <div id="trackInfo" class="track-info-modal" data-modalTrackId="<%= preview_id %>">
                <div id="trackContentInfo" class="track-info-modal-content" data-modalTrackContentId="<%= preview_id %>">
                  <div class="d-flex justify-content-between text-left">
                    <div class="track-info-modal-content-text">
                      <p><u>Loop:</u> <span class="modal-orange-text"><%= track.loop ? "Yes" : "No" %></span><i style="margin-left: 12px" class="fas fa-repeat <%= "d-none" unless track.loop %>"></i></p>
                      <p><u>Title:</u> <span class="modal-orange-text"><%= track.title %></span></p>
                      <p><u>Category:</u> <span class="modal-orange-text"><%= track.category.capitalize %></span></p>
                      <p><u>Size:</u> <span class="modal-orange-text"><%= track.size.to_i > 1_000_000 ? "#{track.size.to_i / 1_000_000} MB" : "#{track.size.to_i / 1_000} KB" %></span></p>
                      <p><u>Duration:</u> <span class="modal-orange-text" id="trackDurationModalid<%= preview_id %>"></span></p>
                      <% if track.sfx_pack_id.present? %>
                        <p><u>Sound Effect Pack:</u> <span class="modal-orange-text"><%= SfxPack.find(track.sfx_pack_id).title %></span></p>
                      <% end %>
                      <p><u>Bitrate:</u> <span class="modal-orange-text"><%= track.bitrate %> bits</span></p>
                      <p><u>Sample rate:</u> <span class="modal-orange-text"><%= track.sample_rate.to_i / 1_000 %> kHz</span></p>
                      <% track.tags.first(8).each do |tag| %>
                        <span class="badge badge-secondary" style="font-size: 12px; margin-bottom: 4px"><%= tag %></span>
                      <% end %>
                    </div>
                    <div>
                      <span class="close" data-modalTrackCloseId="<%= preview_id %>">&times;</span>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        <% end %>
      </ul>

      <div data-controller="template-form">
        <% if current_user.email == "olivier@bamsfx.com" %>
          <div class="plus-icon d-flex">
            <i class="fas fa-plus-circle" data-action="mouseover->template-form#hover mouseout->template-form#mouseout click->template-form#toggleForm"></i>
            <div class="d-flex">
              <div class="invisible-icon d-none" data-template-form-target="leftBorder"></div>
              <p class="template-form-text d-none" data-template-form-target="text">make this collection a template</p>
            </div>
          </div>

          <% categories = ["all", "action", "medieval", "outdoor", "underground", "scary", "monsters", "disasters", "weather", "miscellaneous", "footsteps", "magic", "scifi", "default"] %>
          <div class="d-none justify-content-center mb-3" data-template-form-target="form">
            <%= simple_form_for :template, url: create_collection_template_path, html: { class: "create-template-form" }, method: :post do |form| %>
              <%= form.hidden_field :collection, value: collection.id %>
              <div class="d-flex justify-content-between w-100">
                <%= form.input :title, placeholder: :title, class: "create-template-form-input", wrapper_html: { style: "width: 48%" }, style: "margin-right: 8px" %>
                <%= form.input :categories, placeholder: :categories, class: "create-template-form-input", collection: categories, wrapper_html: { style: "width: 48%" } %>
              </div>
              <%= form.submit "Create Collection Template", class: "btn btn-primary w-100" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<% wrapped_collection = @current_collections.first %>
<% wrapped_tracks_value = SingleTrack.where(id: wrapped_collection.tracks).sum(:price_cents) / 100.0 %>
<% wrapped_savings = (wrapped_tracks_value * conversion_rate) - wrapped_collection.price.to_f %>

<div class="packs-display packs-display-closed d-none cart-collection-panel-closed" id="wrapped-collection-display" data-unwrap-cart-target="collectionWrapped">
  <div class="cart-collection-panel-heading">
    <div class="cart-collection-panel-title">
      <i class="fas fa-layer-group" aria-hidden="true"></i>
      <div>
        <h3>COLLECTION</h3>
        <span>Collection total · <%= humanized_money(@current_collections.first.price, symbol: session[:currency]) %></span>
        <% if wrapped_savings.positive? %>
          <p class="cart-collection-inline-savings d-none" data-unwrap-cart-target="youSpare">You save <%= humanized_money(wrapped_savings, symbol: session[:currency]) %></p>
        <% else %>
          <p class="cart-collection-inline-savings d-none" data-unwrap-cart-target="youSpare"></p>
        <% end %>
      </div>
    </div>
    <div class="cart-collection-panel-actions">
      <%= link_to destroy_collection_path(collection: @current_collections.first), method: :delete, class: "collection-destroy-button", aria: { label: "Remove collection" }, data: { confirm: "Are you sure?" } do %>
        <i class="fas fa-times" aria-hidden="true"></i>
      <% end %>
      <i class="fas fa-angle-down" data-action="click->unwrap-cart#wrap" id="collection-arrow" aria-label="Expand collection"></i>
    </div>
  </div>
</div>
