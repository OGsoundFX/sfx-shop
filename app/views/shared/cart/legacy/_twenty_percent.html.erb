<% if index.positive? %>
  <div class="item-attributes">
    <div class="">
      <div id="wrapper">
        <%= link_to sfx_pack_path(pack) do %>
          <div class="cart-pack-img-container"><%= image_tag pack.photos[0], class: "pack_pic_cart" %></div>
          <div class="pop-up-cart">See Details</div>
        <% end %>
      </div>
    </div>
    <div class="cart-pack-display">
      <div><h3><%= pack.title %></h3></div>
      <div>
        <div class="d-flex">
          <div>
            <h3 class="price-color"><%= humanized_money((pack.price * conversion_rate) * 0.8, symbol: session[:currency]) %></h3>
          </div>
          <div>
            <div id="instead"><i>(instead of <%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %>)</i></div>
          </div>
        </div>
        <div id="instead-mobile"><i>(inst. of <%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %>)</i></div>
      </div>
    </div>
    <div class="cart-form-remove">
      <%= form_tag remove_item_path do %>
        <%= hidden_field_tag 'pack_id', pack.id %>
        <%= button_tag(type: "submit", id: "cart-btn-remove") do %>
            <i class="fas fa-times"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="item-attributes-small">
    <div id="wrapper">
      <%= link_to sfx_pack_path(pack) do %>
        <div><%= image_tag pack.photos[0], width: "150px", class: "pack_pic_cart" %></div>
        <div class="pop-up-cart">See Details</div>
      <% end %>
    </div>
    <div><h3 id="pack-title-small"><%= pack.title %></h3></div>
    <div>
      <div class="d-flex justify-content-center">
        <div>
          <h3 class="price-color"><%= humanized_money((pack.price * conversion_rate) * 0.8, symbol: session[:currency]) %></h3>
        </div>
        <div>
          <div id="instead"><i>(instead of <%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %>)</i></div>
          <div id="instead-mobile"><i>(inst. of <%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %>)</i></div>
        </div>
      </div>
    </div>
      <%= form_tag remove_item_path do %>
      <%= hidden_field_tag 'pack_id', pack.id %>
      <%= submit_tag 'Remove', id: 'btn-remove' %>
    <% end %>
    <div style="height: 20px;"></div>
    <hr>
  </div>

<% else %>
  <div class="item-attributes">
    <div class="">
      <div id="wrapper">
        <%= link_to sfx_pack_path(pack) do %>
          <div class="cart-pack-img-container"><%= image_tag pack.photos[0], width: "150px", class: "pack_pic_cart" %></div>
          <div class="pop-up-cart">See Details</div>
        <% end %>
      </div>
    </div>
    <div class="cart-pack-display">
      <div><h3><%= pack.title %></h3></div>
      <div><h3 class="price-color"><%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %></h3></div>
    </div>
    <div class="cart-form-remove">
      <%= form_tag remove_item_path do %>
        <%= hidden_field_tag 'pack_id', pack.id %>
        <%= button_tag(type: "submit", id: "cart-btn-remove") do %>
            <i class="fas fa-times"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="item-attributes-small">
    <div id="wrapper">
      <%= link_to sfx_pack_path(pack) do %>
        <div><%= image_tag pack.photos[0], width: "150px", class: "pack_pic_cart" %></div>
        <div class="pop-up-cart">See Details</div>
      <% end %>
    </div>
    <div><h3><%= pack.title %></h3></div>
    <div><h3 class="price-color"><%= humanized_money(pack.price * conversion_rate, symbol: session[:currency]) %></h3></div>
    <%= form_tag remove_item_path do %>
      <%= hidden_field_tag 'pack_id', pack.id %>
      <%= submit_tag 'Remove', id: 'btn-remove' %>
    <% end %>
    <div style="height: 20px;"></div>
    <hr>
  </div>
<% end %>