<% pack = SfxPack.find(100) %>
<% if pack.currency_symbol != session[:currency] %>
  <% conversion_rate = CurrencyRate.where("base = ? AND target = ?", pack.currency.upcase, "EUR").order(created_at: :desc).first.rate.to_f %>
<% else %>
  <% conversion_rate = 1 %>
<% end %>

<div class="packs-display" id="single-display" style="visibility: hidden" data-unwrap-cart-target="singleUnwrapped">
  <div class="d-flex justify-content-between">
    <div class="d-flex">
      <i class="fas fa-headphones cart-icon-adjust"></i>
      <div class="d-flex flex-column">
        <h3 class="cart-sfx-packs-title"><strong>SINGLE TRACKS</strong></h3>
        <h5>SUB-TOTAL <%= humanized_money(@single_tracks_value, symbol: session[:currency]) %></h5>
      </div>
    </div>
    <div>
      <i class="fas fa-angle-up" data-action="click->unwrap-cart#wrap" id="single-arrow"></i>
    </div>
  </div>

  <div class="cart-single-tracks-content">
    <% price_difference = (@single_tracks_value - (CollectionCategory.where("points > #{@tracks.sum(:points)}").first.price * conversion_rate).to_i) %>

    <% if !@current_collections.empty? %>
      <div class="container-cart-single-desktop points-banner">
        <div class="d-flex flex-column justify-content-center">
          <span><i class="fas fa-info-circle"></i> Add all these track to your collection and save up to <span style="color: #49cc96"><%= humanized_money(@single_tracks_value, symbol: session[:currency]) %></span> !!!</span>
        </div>
        <div class="d-flex flex-column justify-content-center">
          <span>Total track points <span class="collection-points" style="color: white"><%= @single_tracks_points %></span></span>
        </div>
      </div>
      <div class="container-cart-single-mobile points-banner">
        <div class="d-flex flex-column justify-content-center">
          <strong><span>Total track points <span class="collection-points" style="color: white"><%= @single_tracks_points %></span></span></strong>
        </div>
        <div class="d-flex flex-column justify-content-center add-to-collection-mobile">
          <em><span><i class="fas fa-info-circle"></i> Add all these track to your collection and save up to <span style="color: #49cc96"><%= humanized_money(@single_tracks_value, symbol: session[:currency]) %></span> !!!</span></em>
        </div>
      </div>
      <div class="container">
        <%= link_to "Add tracks to your Collection", convert_path(tracks: @tracks.map { |track| track.id }, points: @tracks.sum(&:points)), method: "post", id: "btn-cart-collection-full-width" %>
      </div>
    <% else %>
      <div class="d-flex justify-content-between container-cart-single-desktop points-banner">
        <div class="d-flex justify-content-between">
          <div class="d-flex flex-column justify-content-center">
            <% if price_difference > 0 %>
              <span><i class="fas fa-info-circle"></i> Get these tracks for <span style="color: #ffa500"><%= humanized_money((CollectionCategory.where("points > #{@tracks.sum(:points)}").first.price * conversion_rate), symbol: session[:currency]) %></span> (save <span style="color: #ffa500"><%= humanized_money((@single_tracks_value - (CollectionCategory.where("points > #{@tracks.sum(:points)}").first.price * conversion_rate).to_i), symbol: session[:currency]) %></span>) convert into a Collection</span>
            <% else %>
              <span><i class="fas fa-info-circle"></i> Create a Collection and get up to 20 tracks for only <span style="color: #ffa500">$5</span>!</span>
            <% end %>
          </div>
        </div>
        <div class="d-flex flex-column justify-content-center">
          <span>Total track points <span class="collection-points" style="color: white"><%= @single_tracks_points %></span></span>
        </div>
      </div>
      <div class="container">
        <%= link_to "Convert these tracks into a Collection", convert_path(tracks: @tracks.map { |track| track.id }, points: @tracks.sum(&:points)), method: "post", id: "btn-cart-collection-full-width" %>
      </div>
    <% end %>

    <ul class="cart-collection-tracks cart-single-track-list">
      <% @tracks.each do |track| %>
        <% preview_id = "#{track.id}tracks" %>
        <li class="cart-collection-track cart-single-track">
          <div class="cart-collection-track-identity">
            <span class="icon-adjust-pack-builder"><%= sanitize @icons[track.category.to_sym] %></span>
            <div class="cart-collection-track-details">
              <span class="cart-collection-track-title"><%= track.title %></span>
              <span class="cart-collection-track-category"><%= track.category.capitalize %> · <%= track.loop? ? "Loop" : "No loop" %></span>
            </div>
            <% if track.loop? %>
              <span class="cart-collection-track-loop" aria-label="Loop"><i class="fas fa-repeat" aria-hidden="true"></i></span>
            <% end %>
          </div>

          <div class="cart-collection-track-preview">
            <div class="wave wave-mobile track-wave <%= controller_name == 'carts' && action_name == 'cart' ? 'wave-cart' : 'wave-index' %>"
                 id="id<%= track.id %>"
                 data-link="<%= track.preview_link %>">
              <div id="loading_flag<%= track.id %>" class="loading-countdown"></div>
            </div>
            <span class="cart-collection-track-duration" id="trackDurationid<%= track.id %>"></span>
            <i class="fas fa-play-circle play-icon-margin-pack-builder cursor cart-collection-desktop-play" id="playid<%= track.id %>" aria-label="Play preview"></i>
            <i class="fas fa-pause-circle play-icon-margin-pack-builder cursor cart-collection-desktop-play" id="stopid<%= track.id %>" style="display: none" aria-label="Pause preview"></i>
            <i class="fas fa-play-circle play-icon-margin-pack-builder cursor cart-collection-mobile-play" id="mobilePlayid<%= track.id %>" aria-label="Play preview"></i>
            <i class="fas fa-pause-circle play-icon-margin-pack-builder cursor cart-collection-mobile-play" id="mobileStopid<%= track.id %>" style="display: none" aria-label="Pause preview"></i>
          </div>

          <div class="cart-collection-track-info">
            <span class="cart-collection-track-points"><%= track.points %> <%= "point".pluralize(track.points) %></span>
            <span class="cart-collection-track-price"><%= humanized_money(track.price * conversion_rate, symbol: session[:currency]) %></span>
            <button type="button" class="cart-collection-track-info-button" id="trackInfoBtn" data-trackId="<%= preview_id %>" aria-label="Details for <%= track.title %>">
              <i class="fas fa-info-circle" aria-hidden="true"></i>
            </button>
            <% if !@collection.nil? && @collection.tracks.include?(track.id) %>
              <%= link_to collection_path(@collection, track: track), method: :patch, class: "cart-collection-track-action", aria: { label: "Remove #{track.title} from collection" } do %>
                <i class="fas fa-layer-minus" aria-hidden="true"></i>
              <% end %>
            <% else %>
              <%= link_to collections_path(track: track), method: :post, class: "cart-collection-track-action", aria: { label: "Add #{track.title} to collection" } do %>
                <i class="fas fa-layer-group" aria-hidden="true"></i>
              <% end %>
            <% end %>

            <% if current_user && Cart.where(user_id: current_user.id).first && Cart.where(user_id: current_user.id).first.sinlge_tracks != nil && Cart.where(user_id: current_user.id).first.sinlge_tracks.include?(track.id) %>
              <%= link_to single_tracks_cart_remove_path(track_id: track.id, page: params[:page]), method: :post, class: "cart-collection-track-action", aria: { label: "Remove #{track.title} from cart" } do %>
                <i class="fas fa-trash-alt" aria-hidden="true"></i>
              <% end %>
            <% else %>
              <%= link_to single_tracks_cart_path(track_id: track.id, page: params[:page]), method: :post, class: "cart-collection-track-action", aria: { label: "Add #{track.title} to cart" } do %>
                <i class="fas fa-cart-plus" aria-hidden="true"></i>
              <% end %>
            <% end %>
          </div>

          <div id="trackInfo" class="track-info-modal" data-modalTrackId="<%= preview_id %>">
            <div id="trackContentInfo" class="track-info-modal-content" data-modalTrackContentId="<%= preview_id %>">
              <div class="d-flex justify-content-between text-left">
                <div class="track-info-modal-content-text">
                  <p><u>Points:</u> <span class="modal-orange-text"><%= track.points %></span></p>
                  <p><u>Title:</u> <span class="modal-orange-text"><%= track.title %></span></p>
                  <p><u>Loop:</u> <span class="modal-orange-text"><%= track.loop ? "Yes" : "No" %></span><i style="margin-left: 12px" class="fas fa-repeat <%= "d-none" unless track.loop %>"></i></p>
                  <p><u>Category:</u> <span class="modal-orange-text"><%= track.category.capitalize %></span></p>
                  <p><u>Size:</u> <span class="modal-orange-text"><%= track.size.to_i > 1_000_000 ? "#{track.size.to_i / 1_000_000} MB" : "#{track.size.to_i / 1_000} KB" %></span></p>
                  <p><u>Duration:</u> <span class="modal-orange-text" id="trackDurationModalid<%= track.id %>"></span></p>
                  <% if track.sfx_pack_id.present? %>
                    <p><u>Sound Effect Pack:</u> <span class="modal-orange-text"><%= SfxPack.find(track.sfx_pack_id).title %></span></p>
                  <% end %>
                  <p><u>Bitrate:</u> <span class="modal-orange-text"><%= track.bitrate %> bits</span></p>
                  <p><u>Sample rate:</u> <span class="modal-orange-text"><%= track.sample_rate.to_i / 1_000 %> kHz</span></p>
                  <% track.tags.first(8).each do |tag| %>
                    <span class="badge badge-secondary" style="font-size: 12px; margin-bottom: 4px"><%= tag %></span>
                  <% end %>
                </div>
                <div>
                  <span class="close" data-modalTrackCloseId="<%= preview_id %>">&times;</span>
                </div>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="d-flex justify-content-end">
    <div class="d-flex sub-total">
      <div>SUB-TOTAL</div>
      <div><%= humanized_money(@single_tracks_value, symbol: session[:currency]) %></div>
    </div>
  </div>

  <%= render "shared/coming_soon_modals" %>
</div>

<div class="packs-display packs-display-closed d-none" id="wrapped-single-display" data-unwrap-cart-target="singleWrapped">
  <div class="d-flex justify-content-between">
    <div class="d-flex">
      <i class="fas fa-headphones cart-icon-adjust"></i>
      <div class="d-flex flex-column">
        <h3 class="cart-sfx-packs-title"><strong>SINGLE TRACKS</strong></h3>
        <h5>SUB-TOTAL <%= humanized_money(@single_tracks_value, symbol: session[:currency]) %></h5>
      </div>
    </div>
    <div>
      <i class="fas fa-angle-down" data-action="click->unwrap-cart#wrap" id="single-arrow"></i>
    </div>
  </div>
</div>
