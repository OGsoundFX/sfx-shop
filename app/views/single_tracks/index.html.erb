<div class="content" data-controller="video-modal" data-action="keydown@window->video-modal#closeOnEscape">
  <div class="banner">
    <h1 class="padding-navbar font-permanent-marker">Build your own Sound Pack!!!</h1>
    <button type="button" class="pack-builder-demo-button mb-5" data-video-modal-target="button" data-action="click->video-modal#openModal">
      Watch the demo
    </button>
  </div>
  <div class="pack-builder-demo-modal" data-video-modal-target="videoModal" data-action="click->video-modal#closeOnOutsideClick" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="pack-builder-demo-title">
    <div class="pack-builder-demo-modal__content">
      <div class="pack-builder-demo-modal__header">
        <h2 id="pack-builder-demo-title">Pack Builder demo</h2>
        <button type="button" class="pack-builder-demo-modal__close" data-video-modal-target="close" data-action="click->video-modal#closeModal" aria-label="Close video">&times;</button>
      </div>
      <video controls playsinline preload="none" data-video-modal-target="video">
        <source src="https://bamsfx-general-content.s3.eu-central-1.amazonaws.com/pack_builder_presentation.mp4" type="video/mp4">
        Your browser does not support HTML video.
      </video>
    </div>
  </div>
  <%= render "shared/left_pannel_mobile"%>
  <div class="d-flex">
    <%= render "shared/left_pannel_desktop"%>
    <div class="container-fluid">
      <section class="home-pack-builder-callout" aria-labelledby="home-pack-builder-title">
        <div class="home-pack-builder-callout__copy">
          <h2 id="home-pack-builder-title">Want to build your own pack?</h2>
          <p>Pick the sounds you need and create a collection that fits your project.</p>
        </div>
        <%= link_to "Build your pack", pack_builder_path, class: "home-pack-builder-callout__button" %>
      </section>
      <div class="track-search-desktop">
        <%= render "track_search_desktop" %>
      </div>
      <div class="track-search-mobile">
        <%= render "track_search_mobile" %>
      </div>
      <%= render 'shared/paginate_tracks' %>
    </div>
  </div>
</div>

<!-- The Learn More Modal -->
<div id="learnMore" class="learn-more-modal">
  <!-- Modal content -->
  <div class="learn-more-modal-content">
    <span class="learn-more-close">&times;</span>
    <div class="d-flex justify-content-center">
      <div>
        <%= image_tag asset_path('knight.png'), id: "knight-gif" %>
      </div>
      <div>
        <h2 id="comming-soon">Create your Collection!!!</h2>
      </div>
    </div>
    <%# <br>
    <h5><span class="orange-words">Collections</span> are a very cool feature that lets you
    create your own <span class="orange-words">Sound Effects Pack</span>.</h5>
    <p>You might need a very specific set of sounds for your film or video game. You might not want to pay for 3 different packs or
    buy the tracks separately which can become pretty expensive!</p>
    <br><h3 style="text-align: center">Introducing the <span class="orange-words">Collection System</span></h3> %>
    <br><h5><%= image_tag asset_path('sword.png'), id: "sword-gif" %>Select your tracks buy clicking on the <i class="fas fa-layer-group orange-words"></i> icon.
    <br><%= image_tag asset_path('sword.png'), id: "sword-gif" %>Each track is attributed some points <span id="point-explanation-modal">&nbsp1&nbsp</span> which are added up to determine your very attractive collection price!
    <br><%= image_tag asset_path('sword.png'), id: "sword-gif" %>You can get up to <span class="orange-words">20</span> tracks for just <span class="orange-words">$5</span> check it out!!!</h5><br>
    <%= image_tag asset_path('collection.png'), id: "collection-image" %>
  </div>
</div>
