<% if "$" != session[:currency] %>
  <% conversion_rate = CurrencyRate.where("base = ? AND target = ?", "USD", "EUR").order(created_at: :desc).first.rate.to_f %>
<% else %>
  <% conversion_rate = 1 %>
<% end %>
<div class="pack-builder" >
  <div class="collection" >
    <div class="div" >
      <div class="div-2" >
        <div class="heading" >
          <div style="color: white" >
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="title" >Pack builder</div>
        </div>
        <div class="item-count" >
          <% count = @collection ? @collection.tracks.count : 0 %>
          <div class="count" ><%= count %> <%= 'sound'.pluralize(count) %></div>
        </div>
      </div>
      <div class="project-name" >
        <div class="pack-name" >Late night sketches</div>
        <div id="pack-builder-name-edit" >
          <i class="fas fa-edit"></i>
        </div>
      </div>
    </div>
    <div class="selected-sounds" >
      <div class="selected-sound" >
        <div class="sound-artwork" >
          <div class="audio-lines" >
            <img class="vector-2" src="img/vector-13.svg" />
          </div>
        </div>
        <div class="sound-details" >
          <div class="sound-title" >Glass Horizon</div>
          <p class="sound-metadata" >Synth loop · 90 BPM</p>
        </div>
        <div class="sound-price" >$2.50</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector.svg" />
        </div>
      </div>
      <div class="selected-sound" >
        <div class="audio-lines-wrapper" >
          <div class="audio-lines" >
            <img class="vector-2" src="img/vector-9.svg" />
          </div>
        </div>
        <div class="sound-details" >
          <div class="sound-title" >Soft Current</div>
          <div class="sound-metadata" >Texture · C maj</div>
        </div>
        <div class="sound-price" >$1.50</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/image.svg" />
        </div>
      </div>
      <div class="selected-sound" >
        <div class="sound-artwork" >
          <div class="audio-lines" >
            <img class="vector-2" src="img/vector-7.svg" />
          </div>
        </div>
        <div class="sound-details" >
          <div class="sound-title" >Night Drive</div>
          <p class="sound-metadata" >Drum loop · 100 BPM</p>
        </div>
        <div class="sound-price" >$3.00</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-4.svg" />
        </div>
      </div>
      <div class="selected-sound" >
        <div class="div-wrapper" >
          <div class="audio-lines" >
            <img class="vector-2" src="img/vector-2.svg" />
          </div>
        </div>
        <div class="sound-details" >
          <div class="sound-title" >Vinyl Air</div>
          <div class="sound-metadata" >Texture · 0:30</div>
        </div>
        <div class="sound-price" >$2.00</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-10.svg" />
        </div>
      </div>
    </div>
    <div class="div-2" >
      <div class="saved-state" >
        <div class="cloud-check" >
          <img class="vector-4" src="img/vector-11.svg" />
        </div>
        <div class="save-status" >Selection saved</div>
      </div>
      <div class="clear-collection" >Clear all</div>
    </div>
  </div>
  <div class="div" >
    <div class="license" >
      <div class="img-wrapper" >
        <img class="vector-5" src="img/vector-5.svg" />
      </div>
      <div class="license-details" >
        <div class="license-title" >Royalty-free license included</div>
        <p class="text-wrapper" >WAV · 24-bit · 44.1 kHz</p>
      </div>
    </div>
    <div class="pricing" >
      <div class="subtotal" >
        <p class="text-wrapper-2" >4 sounds × individual prices</p>
        <div class="text-wrapper-2" >$9.00</div>
      </div>
      <div class="pricing-divider" ></div>
      <div class="div-2" >
        <div class="total-label" >Pack total</div>
        <div class="total-amount" >
          <div class="price" ><%= humanized_money(@collection.price * conversion_rate, symbol: session[:currency]) %></div>
        </div>
      </div>
    </div>
    <%= link_to cart_path, class: 'w-100' do %>
      <div class="add-pack-to-cart" >
        <i class="fas fa-shopping-cart"></i>
        <div class="action-label" >Add pack to cart</div>
        <i class="fas fa-arrow-right"></i>
      </div>
    <% end %>
    <p class="purchase-note" >No subscription · Tax included</p>
  </div>
</div>
