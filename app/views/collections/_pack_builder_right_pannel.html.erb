<% if "$" != session[:currency] %>
  <% conversion_rate = CurrencyRate.where("base = ? AND target = ?", "USD", "EUR").order(created_at: :desc).first.rate.to_f %>
<% else %>
  <% conversion_rate = 1 %>
<% end %>
<% collection_track_ids = @collection&.tracks || [] %>
<% collection_tracks = SingleTrack.where(id: collection_track_ids).index_by(&:id) %>
<% individual_value = collection_tracks.values.sum(&:price_cents) / 100.0 %>
<% collection_savings = individual_value - (@collection&.price&.to_f || 0) %>
<div class="pack-builder" >
  <div class="collection" >
    <div class="div" >
      <div class="div-2" >
        <div class="heading" >
          <div style="color: white" >
            <i class="fas fa-layer-group"></i>
          </div>
          <div class="title" >Pack builder</div>
        </div>
        <%= render 'collections/right_pannel_elements/top_track_count', collection: @collection %>
      </div>
      <div class="project-name" >
        <div class="pack-name" >Name your pack</div>
        <div id="pack-builder-name-edit" >
          <i class="fas fa-edit"></i>
        </div>
      </div>
    </div>    
    <%= render "collections/right_pannel_elements/selected_track_list",
        collection: @collection,
        collection_track_ids: collection_track_ids,
        collection_tracks: collection_tracks,
        conversion_rate: conversion_rate
      %>
  </div>
  <div class="div" >
    <div class="license" >
      <div class="img-wrapper" >
        <img class="vector-5" src="img/vector-5.svg" />
      </div>
      <div class="license-details" >
        <div class="license-title" >Royalty-free license included</div>
        <p class="text-wrapper" >WAV · 24-bit · 44.1 kHz</p>
      </div>
    </div>

    <%= render "collections/right_pannel_elements/total_price_recap",
        collection: @collection,
        conversion_rate: conversion_rate,
        collection_savings: collection_savings,
        individual_value: individual_value
      %>

    <%= link_to cart_path, class: 'w-100' do %>
      <div class="add-pack-to-cart" >
        <i class="fas fa-shopping-cart"></i>
        <div class="action-label" >Add pack to cart</div>
        <i class="fas fa-arrow-right"></i>
      </div>
    <% end %>
    <p class="purchase-note" >No subscription · Tax included</p>
  </div>
</div>
