<div class="sound-catalog" >
  <div class="search-and-filters" >
    <div class="catalog-heading" >
      <div class="catalog-title" >
        <div class="title" >Explore sounds</div>
        <div class="text-wrapper" ><%= @total_sounds %> sounds</div>
      </div>
      <div class="preview-preference" >
        <div class="vector-wrapper" >
          <img class="vector" src="img/vector-4.svg" />
        </div>
        <div class="div" >Loop preview</div>
        <div class="toggle-on" >
          <div class="thumb" ></div>
        </div>
      </div>
    </div>
    <div class="search-field" >
      <div class="search" >
        <img class="img" src="img/vector-33.svg" />
      </div>
      <div class="search-query" >ambient</div>
      <div class="x" >
        <img class="vector-2" src="img/vector-18.svg" />
      </div>
      <div class="divider" ></div>
      <div class="text-wrapper" >⌘ K</div>
    </div>
    <div class="filters" >
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Type</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-26.svg" />
        </div>
      </div>
      <div class="catalog-filter-2" >
        <div class="filter-label" >Genre · Ambient</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-22.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >BPM</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-9.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Key</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-7.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Price</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-20.svg" />
        </div>
      </div>
      <div class="clear-filters" >Reset</div>
      <div class="vector-wrapper" >
        <img class="vector-4" src="img/vector-8.svg" />
      </div>
      <div class="text-wrapper-2" >All filters</div>
    </div>
  </div>
  <div class="navbar" >
    <div class="results" ><%= @sfx_tracks.count %> RESULTS</div>
    <div class="waveform-column" >PREVIEW</div>
    <div class="tempo-column" >INFO</div>
    <div class="key-column" >POINTS</div>
    <div class="price-column" >PRICE</div>
    <div class="sort" >
      <div class="text-wrapper-3" >Relevant</div>
      <div class="chevron-down" >
        <img class="vector-5" src="img/vector-25.svg" />
      </div>
    </div>
  </div>
  <div class="scrollable-results" >

    <% @sfx_tracks.each do |track| %>
      <div class="sound" >
        <div class="playing-indicator" ></div>
        <div class="sound-identity" >
          <div class="preview-action" >
            <div class="vector-wrapper" >
              <img class="vector-6" src="img/vector-29.svg" />
            </div>
          </div>
          <div class="sound-artwork" >
            <div class="audio-lines" >
              <img class="vector-7" src="img/vector-6.svg" />
            </div>
          </div>
          <div class="sound-details" >
            <div class="sound-title" ><%= track.title %></div>
            <p class="sound-source" ><%= track.category.capitalize %> · <%= track.loop? ? 'loop' : 'no-loop' %></p>
          </div>
        </div>

        <div class="d-flex wave-section justify-content-between elements-position">
          <% if controller_name == 'carts' && action_name == 'cart'%>
            <div class="wave collection-wave wave-cart" id="id<%= "#{track.id}" %>" data-link="<%= track.preview_link %>">
              <div id="loading_flag<%= "#{track.id}" %>" class="loading-countdown"></div>
            </div>
          <% else %>
            <div class="wave collection-wave wave-index-pack-builder" id="id<%= track.id %>" data-link="<%= track.preview_link %>">
              <div id="loading_flag<%= "#{track.id}" %>" class="loading-countdown"></div>
            </div>
          <% end %>
          <p class="info-font pad-top-cart" id="trackDurationid<%= "#{track.id}" %>"></p>
          <i class="fas fa-play-circle pad-top-cart play-icon-margin cursor" id="playid<%= "#{track.id}"%>"></i>
          <i class="fas fa-pause-circle pad-top-cart play-icon-margin cursor" id="stopid<%= "#{track.id}" %>" style="display: none"></i>
        </div>

        <div class="tempo" ><span class="info-icon-template template-max-width-icon" id="trackInfoBtn" data-trackId="<%= track.id %>"><i class="fas fa-info-circle"></i></span></div>
        <div class="key" >F min</div>
        <div class="price" >$2.50</div>
        <div class="pack-action" >
          <div class="img-wrapper" >
            <img class="vector-8" src="img/vector-11.svg" />
          </div>
          <div class="action-label" >Added</div>
        </div>
      </div>

                      <!-- The Track Info Modal -->
                <div id="trackInfo" class="track-info-modal" data-modalTrackId="<%= track.id %>">
                  <!-- Modal content -->
                  <div id="trackContentInfo" style="text-align: start" class="track-info-modal-content" data-modalTrackContentId="<%= track.id %>">
                    <div class="d-flex justify-content-between">
                      <div class="track-info-modal-content-text">
                        <p><u>Points:</u> <span class="modal-orange-text" ><%= track.points %></span></p>
                        <p><u>Title:</u> <span class="modal-orange-text" ><%= track.title %></span></p>
                        <p><u>Loop:</u> <span class="modal-orange-text"><%= track.loop ? "Yes" : "No" %></span><i style="margin-left: 12px" class="fas fa-repeat <%= 'd-none' if !track.loop %>"></i></p>
                        <p><u>Category:</u> <span class="modal-orange-text" ><%= track.category.capitalize %></span></p>
                        <p><u>Size:</u> <span class="modal-orange-text" ><%= track.size.to_i > 1_000_000 ? "#{track.size.to_i / 1_000_000} MB" : "#{track.size.to_i / 1_000} KB" %></span></p>
                        <p><u>Duration:</u> <span class="modal-orange-text" id="trackDurationModalid<%= track.id %>"></span></p>
                        <% if !track.sfx_pack_id.nil? %>
                          <p><u>Sound Effect Pack:</u> <span class="modal-orange-text" ><%= SfxPack.find(track.sfx_pack_id).title %></span></p>
                        <% end %>
                        <p><u>Bitrate:</u> <span class="modal-orange-text" ><%= track.bitrate %> bits</span></p>
                        <p><u>Sample rate:</u> <span class="modal-orange-text" ><%= (track.sample_rate.to_i / 1_000) %> kHz</span></p>
                        <% track.tags.first(8).each do |tag| %>
                          <span class="badge badge-secondary" style="font-size: 12px; margin-bottom: 4px"><%= tag %></span>
                        <% end %>
                      </div>
                      <div>
                        <span class="close" data-modalTrackCloseId="<%= track.id %>">&times;</span>
                      </div>
                    </div>
                  </div>
                </div>

    <% end %>
