<% pack = SfxPack.find(100) %>
<% if pack.currency_symbol != session[:currency] %>
  <% conversion_rate = CurrencyRate.where("base = ? AND target = ?", pack.currency.upcase, "EUR").order(created_at: :desc).first.rate.to_f %>
<% else %>
  <% conversion_rate = 1 %>
<% end %>
<div class="sound-catalog" >
  <div class="search-and-filters" >
    <div class="catalog-heading" >
      <div class="catalog-title" >
        <div class="title" >Explore sounds</div>
        <div class="text-wrapper" ><%= @total_sounds %> sounds</div>
      </div>
      <div class="preview-preference" >
        <div class="vector-wrapper" >
          <img class="vector" src="img/vector-4.svg" />
        </div>
        <div class="div" >Loop preview</div>
        <div class="toggle-on" >
          <div class="thumb" ></div>
        </div>
      </div>
    </div>
    <%= render 'track_search_pack_builder' %>
    <div class="filters" >
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Type</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-26.svg" />
        </div>
      </div>
      <div class="catalog-filter-2" >
        <div class="filter-label" >Genre · Ambient</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-22.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >BPM</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-9.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Key</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-7.svg" />
        </div>
      </div>
      <div class="catalog-filter" >
        <div class="text-wrapper-2" >Price</div>
        <div class="img-wrapper" >
          <img class="vector-3" src="img/vector-20.svg" />
        </div>
      </div>
      <div class="clear-filters" >Reset</div>
      <div class="vector-wrapper" >
        <img class="vector-4" src="img/vector-8.svg" />
      </div>
      <div class="text-wrapper-2" >All filters</div>
    </div>
  </div>
  <div class="navbar" >
    <div class="results" ><%= @total_sounds %> RESULTS</div>
    <div class="waveform-column" >PREVIEW</div>
    <div class="tempo-column" >INFO</div>
    <div class="key-column" >POINTS</div>
    <div class="price-column" >PRICE</div>
    <div class="sort" >
      <div class="text-wrapper-3" >Relevant</div>
      <div class="chevron-down" >
        <img class="vector-5" src="img/vector-25.svg" />
      </div>
    </div>
  </div>
  <div class="scrollable-results" >
    <% @sfx_tracks.each do |track| %>
      <div class="sound" >
        <div class="playing-indicator" ></div>
        <div class="sound-identity" >
          <span class="icon-adjust-pack-builder"><%= sanitize @icons[track.category.to_sym] %></span>
          <div class="sound-details" >
            <div class="sound-title" ><%= track.title %></div>
            <span class="sound-source" ><%= track.category.capitalize %> · <%= track.loop? ? 'loop' : 'no-loop' %></span>
          </div>
        </div>

        <div class="d-flex wave-section-pack-builder justify-content-between elements-position">
          <% if controller_name == 'carts' && action_name == 'cart'%>
            <div class="wave collection-wave wave-cart" id="id<%= "#{track.id}" %>" data-link="<%= track.preview_link %>">
              <div id="loading_flag<%= "#{track.id}" %>" class="loading-countdown"></div>
            </div>
          <% else %>
            <div class="wave collection-wave wave-index-pack-builder" id="id<%= track.id %>" data-link="<%= track.preview_link %>">
              <div id="loading_flag<%= "#{track.id}" %>" class="loading-countdown"></div>
            </div>
          <% end %>
          <span class="info-font-pack-builder" id="trackDurationid<%= "#{track.id}" %>"></span>
          <i class="fas fa-play-circle play-icon-margin-pack-builder cursor" id="playid<%= "#{track.id}"%>"></i>
          <i class="fas fa-pause-circle pad-top-cart play-icon-margin cursor" id="stopid<%= "#{track.id}" %>" style="display: none"></i>
        </div>

        <div class="tempo" ><span class="info-icon-template-pack-builder template-max-width-icon" id="trackInfoBtn" data-trackId="<%= track.id %>"><i class="fas fa-info-circle"></i></span></div>
        <div class="key" ><%= track.points %></div>
        <div class="price" >
          <% if humanized_money(track.price * conversion_rate, symbol: session[:currency]).include?(".") %>
            <%= humanized_money(track.price * conversion_rate, symbol: session[:currency]) %>
          <% else %>
            <%= humanized_money(track.price * conversion_rate, symbol: session[:currency]) %>.00
          <% end %>
        </div>
        <div class="pack-action" >
          <div class="img-wrapper" >
            <img class="vector-8" src="img/vector-11.svg" />
          </div>
          <div class="action-label" >Added</div>
        </div>
      </div>

      <div id="trackInfo" class="pack-builder-track-info-modal" data-modalTrackId="<%= track.id %>">
        <div id="trackContentInfo" class="pack-builder-track-info-content" data-modalTrackContentId="<%= track.id %>">
          <div class="pack-builder-track-info-header">
            <h2 class="pack-builder-track-info-heading">Sound details</h2>
            <button type="button" class="pack-builder-track-info-close" aria-label="Close" data-modalTrackCloseId="<%= track.id %>">&times;</button>
          </div>
          <div class="pack-builder-track-info-details">
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Points</span>
              <span class="pack-builder-track-info-value"><%= track.points %></span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Title</span>
              <span class="pack-builder-track-info-value"><%= track.title %></span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Loop</span>
              <span class="pack-builder-track-info-value">
                <%= track.loop ? "Yes" : "No" %>
                <% if track.loop %>
                  <i class="fas fa-repeat pack-builder-track-info-loop-icon" aria-hidden="true"></i>
                <% end %>
              </span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Category</span>
              <span class="pack-builder-track-info-value"><%= track.category.capitalize %></span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Size</span>
              <span class="pack-builder-track-info-value"><%= track.size.to_i > 1_000_000 ? "#{track.size.to_i / 1_000_000} MB" : "#{track.size.to_i / 1_000} KB" %></span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Duration</span>
              <span class="pack-builder-track-info-value" id="trackDurationModalid<%= track.id %>"></span>
            </div>
            <% if !track.sfx_pack_id.nil? %>
              <div class="pack-builder-track-info-row">
                <span class="pack-builder-track-info-label">Sound Effect Pack</span>
                <span class="pack-builder-track-info-value"><%= SfxPack.find(track.sfx_pack_id).title %></span>
              </div>
            <% end %>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Bitrate</span>
              <span class="pack-builder-track-info-value"><%= track.bitrate %> bits</span>
            </div>
            <div class="pack-builder-track-info-row">
              <span class="pack-builder-track-info-label">Sample rate</span>
              <span class="pack-builder-track-info-value"><%= (track.sample_rate.to_i / 1_000) %> kHz</span>
            </div>
          </div>
          <% if track.tags.any? %>
            <div class="pack-builder-track-info-tags">
              <% track.tags.first(8).each do |tag| %>
                <span class="pack-builder-track-info-tag"><%= tag %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="pack-builder-pagination">
      <%= paginate @sfx_tracks %>
    </div>
    <div class="scroll-track" >
      <div class="scroll-thumb" ></div>
    </div>
  </div>
  <div class="results-footer" >
    <p class="text-wrapper" >Showing 1-8 of 248 · Scroll to explore more</p>
    <div class="keyboard-hint" >
      <div class="text-wrapper-3" >SPACE</div>
      <div class="shortcut-description" >play / pause</div>
    </div>
  </div>
</div>
