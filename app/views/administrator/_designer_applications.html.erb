<%= render "designer_submissions_menu" %>
<div class="submission-container text-center" data-controller="designer-submission-filter">
  <div style="width: 100vw">
    <div class="text-start text-white ml-5 d-flex justify-content-between align-items-center">
      <div>
        <h6>Applications count: <span data-designer-submission-filter-target="count"></span> / <%= @submissions.count %></h6>
      </div>
      <div>
        <div class="btn btn-secondary me-2 btn-admin btn-admin-active" data-action="click->designer-submission-filter#filter" data-designer-submission-filter-target="tab" data-status="pending">Pending</div>
        <div class="btn btn-secondary me-2 btn-admin" data-action="click->designer-submission-filter#filter" data-designer-submission-filter-target="tab" data-status="profile_created">Incomplete</div>
        <div class="btn btn-secondary me-2 btn-admin" data-action="click->designer-submission-filter#filter" data-designer-submission-filter-target="tab" data-status="accepted">Accepted</div>
        <div class="btn btn-secondary me-2 btn-admin" data-action="click->designer-submission-filter#filter" data-designer-submission-filter-target="tab" data-status="rejected">Rejected</div>
      </div>
    </div>
    <% @submissions.each do |submission| %>
      <div class="submission-card d-flex justify-content-between" data-designer-submission-filter-target="submission" data-status="<%= submission.status %>">
        <div class="d-flex align-items-center">
          <div class="submission-card-date">
            <div class="submission-day"><%= submission.created_at.strftime("%b %y") %></div>
            <div class="submission-date"><%= submission.created_at.strftime("%d") %></div>
          </div>
          <div class="submission-card-content">
            <div class="title"><%= submission.first_name %> <%= submission.last_name %> <span class="status"><%= "(#{submission.status})" unless submission.status == "accepted" %></span></div>
          </div>
          <% if submission.status == "accepted" %>            
            <div class="designer-dashboard__label mt-2">
              <i class="fas fa-check-circle approved-icon"></i>
            </div>
          <% end %>
        </div>

        <div class="d-flex flex-column">
          <% submission.submission_links.each do |link| %>
            <div class="d-flex">
              <%= link_to link.title, link.url, target: "_blank" %>
              <div class="submission-link-tooltip <%= 'd-none' unless link.description.present? %> ml-3">
                <i class="fas fa-info-circle ms-2"></i>
                <span class="submission-link-tooltiptext"><%= link.description %></span>
              </div>
            </div>
          <% end %>
        </div>

        <div>
          <div class="submission-card-actions">
            <% if !["accepted", "rejected"].include?(submission.status)  %>
              <%= link_to "Incomplete", complete_submission_path(submission.id), class: "btn btn-orange" %>
            <% end %>
            <div class="btn-group btn-group--lg bookings__info-fa" role="group" aria-label="Basic example">
              <% if !["accepted", "rejected"].include?(submission.status) %>
                <%= button_to submission_accepted_path(submission.id), method: "patch", class: "submission-card_btn-group submission-card__confirm-accept" do %>
                  <div >
                    <i class="fas fa-check"></i>
                  </div>
                <% end %>
                <%= button_to submission_rejected_path(submission.id), method: "patch", data: { turbo_confirm: "Are you sure?" }, class: "submission-card_btn-group submission-card__confirm-reject" do %>
                  <div>
                    <i class="fas fa-ban"></i>
                  </div>
                <% end %>
              <% else %>
                
                <% if submission.status == "accepted" %>
                  <div class="align-items-center d-flex justify-content-center me-3">
                    <small><em><%= submission.user.sound_designer.present? ? 'Designer profile created' : 'Waiting for designer profile' %></em></small>
                  </div>
                  <%= button_to submission_rejected_path(submission.id), method: "patch", data: { turbo_confirm: "Are you sure?" }, class: "btn btn-warning" do %>
                    Cancel
                  <% end %>
                <% else %>
                  <%= button_to submission_accepted_path(submission.id), method: "patch", class: "btn btn-admin-active" do %>
                    Accept
                  <% end %>
                <% end %>
              <% end %>
            </div>
            <%= link_to "Remove", designer_submission_path(submission.id), class: "btn btn-reject", data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>